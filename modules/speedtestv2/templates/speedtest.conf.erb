server {
        server_name _ localhost <%= @fqdn %>;
        #listen 80  reuseport;
        listen 443 ssl reuseport;
        #listen [::]:80 reuseport;
        listen [::]:443 ssl reuseport;
        # If you like to Enable HTTP2 add "http2" to the above line.
        # If HTTP2 Enabled. Upload location should Proxy_Pass to http 1.1 port.
        # Otherwise you will see abnormal Upload Speeds.
        # Nginx Server Windows SSL Performance was very poor! Better use Linux if you need SSL support.
        ssl_certificate /etc/ssl/certs/<%= @fqdn %>.crt;
        ssl_certificate_key /etc/ssl/private/<%= @fqdn %>.key;
        # TLSv1/1.1 are deprecated and are refused outright by OpenSSL 3 at the
        # default security level. Cipher selection is left to the nginx default.
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
	ssl_session_cache shared:SSL:100m;
	ssl_session_timeout 1d;
	ssl_session_tickets on;
        root /usr/share/nginx/html/;
        index index.html;
        client_max_body_size 35m;
        error_page 405 =200 $uri;
        # Access logging stays off on purpose: a speed test generates a huge
        # number of requests and logging them skews the result.
        access_log off;
        gzip off;
        fastcgi_read_timeout 999;
        log_not_found off;
        server_tokens off;
        error_log /var/log/nginx/speedtest_error.log warn;
        tcp_nodelay on;
        tcp_nopush on;
        sendfile on;
        open_file_cache max=200000 inactive=20s;
        open_file_cache_valid 30s;
        open_file_cache_min_uses 2;
        open_file_cache_errors off;

        # Upstream ships CORS headers here so the test can be embedded from
        # another origin. We serve it directly, so the requests are same-origin
        # and no cross-origin access is granted.
        location / {
            #Very Very Important! You SHOULD send no-store from server for Google Chrome.
            add_header Cache-Control 'no-store, no-cache, max-age=0, no-transform';
            add_header Last-Modified $date_gmt;
            if_modified_since off;
            expires off;
            etag off;
        }

       #HTTP2 & HTTP3 will not wait for the post body and return 200. We need to stop that behaviour.
       #Otherwise, you will see abnormal upload speed. To fix this issue, Enable the following lines. (Only Applicable If you Enabled HTTP2 or HTTP3 in This Server.)

       #HTTP2 & HTTP3 -> UPLOAD FIX -- START

       #location = /upload {
       #    proxy_pass http://127.0.0.1:80/dev-null;
       #}
       #location = /dev-null {
       #    return 200;
       #}

       #HTTP2 & HTTP3 -> UPLOAD FIX -- END

      # Caching for Static Files,
      location ~* ^.+\.(?:css|cur|js|jpe?g|gif|htc|ico|png|html|xml|otf|ttf|eot|woff|woff2|svg)$ {
          access_log off;
          expires 365d;
          add_header Cache-Control public;
          add_header Vary Accept-Encoding;
          tcp_nodelay off;
          open_file_cache max=3000 inactive=120s;
          open_file_cache_valid 45s;
          open_file_cache_min_uses 2;
          open_file_cache_errors off;
          gzip on;
          gzip_disable "msie6";
          gzip_vary on;
          gzip_proxied any;
          gzip_comp_level 6;
          gzip_buffers 16 8k;
          gzip_http_version 1.1;
          gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript image/svg+xml;
      }
}


server {
    listen  80 default_server;
    listen  [::]:80 default_server;
    server_name _ localhost <%= @fqdn %>;

    location / {
        return 301 https://$host$request_uri;
    }
}